{
    "_comment": "TreeDB GUI shell config. Three primary options: Connections (the backends this app browses, where a session starts) and then the WORK -- Topics (table editors) and Graphs (node graphs). Preferences hangs off the toolbar avatar as /preferences. Two per-workspace rails — Topics (table editors) and Graphs (node graphs). Each declares ONLY its fixed picker tab (C_TREEDB_PICKER: manage connections + check which treedbs to open); the C_TREEDB_APP controller replaces the submenu at runtime, keeping the picker as tab 0 and appending one closable tab per selected treedb of a CONNECTED backend. The picker target.kw carries only the workspace string; the dynamic treedb tabs carry the live gobj_remote_yuno pointer (built in JS via yui_shell_set_submenu). Theme/language/logout live in the top toolbar. Connections + tokens are browser-local (localStorage).",

    "shell": {
        "breakpoints": "bulma",

        "zones": {
            "top":     { "host": "toolbar",        "show_on": "*" },
            "left":    { "host": "menu.primary",   "show_on": ">=desktop" },
            "bottom":  { "host": "menu.primary",   "show_on": "<desktop"  },
            "top-sub": { "host": "menu.secondary", "show_on": "*" },
            "center":  { "host": "stage.main" }
        },

        "stages": {
            "main": { "zone": "center", "default_route": "/topics/select" }
        },

        "_routes_comment": "Resolution-ancestor routes for the per-workspace dynamic treedb tabs (a tab /<ws>/db/<sel> resolves here on F5 before the controller rebuilds it). Both point at the workspace picker (/<ws>/select) so an F5 shows the treedb selector while the backend connects; once EV_ON_OPEN rebuilds the tab, C_TREEDB_APP.restore_tab_from_url re-navigates to it so the reload lands on the tab the operator was on. /connections and /preferences are first-level routes: /connections is the first item of the rail (the BACKENDS manager; the per-workspace /<ws>/select is a different page -- which treedbs of a backend to open -- and links to it), /preferences hangs off the avatar menu, and both stay ROUTES so they are linkable, survive an F5 and appear in the site map. They are two pages and not one because they are two different things: the backends are what the app BROWSES -- shared by both workspaces, the thing a picker sends you to -- while preferences are what this browser chose.",
        "routes": {
            "/connections": {
                "stage": "main",
                "gclass": "C_TREEDB_CONNECTIONS",
                "kw": { "title": "connections" },
                "lifecycle": "lazy_destroy"
            },
            "/preferences": {
                "stage": "main",
                "gclass": "C_TREEDB_PREFERENCES",
                "kw": { "title": "preferences" },
                "lifecycle": "lazy_destroy"
            },
            "/topics/db": {
                "stage": "main",
                "gclass": "C_TREEDB_PICKER",
                "kw": { "workspace": "topics", "title": "select" },
                "lifecycle": "keep_alive"
            },
            "/graphs/db": {
                "stage": "main",
                "gclass": "C_TREEDB_PICKER",
                "kw": { "workspace": "graphs", "title": "select" },
                "lifecycle": "keep_alive"
            }
        }
    },

    "toolbar": {
        "zone": "top",
        "aria_label": "TreeDB GUI toolbar",
        "items": [
            {
                "id": "brand",
                "type": "brand",
                "logo": "/treedb-mark.svg",
                "wordmark": "TreeDB GUI",
                "alt": "TreeDB GUI",
                "aria_label": "TreeDB GUI home",
                "action": { "type": "navigate", "route": "/topics/select" }
            },
            {
                "id": "lang",
                "icon": "yi-language",
                "name": "ES/EN",
                "align": "end",
                "aria_label": "Toggle language",
                "action": { "type": "event", "event": "EV_TOGGLE_LANGUAGE" }
            },
            {
                "id": "theme",
                "icon": "yi-moon",
                "name": "",
                "align": "end",
                "aria_label": "Toggle dark theme",
                "action": { "type": "event", "event": "EV_TOGGLE_THEME" }
            },
            {
                "id": "user",
                "type": "avatar",
                "align": "end",
                "aria_label": "Account menu",
                "action": {
                    "type": "dropdown",
                    "_items_comment": "Account menu: the operator's own preferences first, then the developer tools and the informative entries. The BACKENDS are not here: they are a rail item (/connections), because they are where a session starts and both workspaces depend on them.",
                    "items": [
                        {
                            "id": "preferences",
                            "name": "preferences",
                            "icon": "yi-gear",
                            "action": { "type": "navigate", "route": "/preferences" }
                        },
                        { "type": "divider" },
                        {
                            "id": "developer",
                            "name": "developer",
                            "icon": "yi-square-js",
                            "action": { "type": "event", "event": "EV_OPEN_DEVTOOLS" }
                        },
                        {
                            "id": "frontend",
                            "name": "frontend view",
                            "icon": "yi-hexagon-nodes",
                            "action": { "type": "event", "event": "EV_OPEN_FRONTEND_VIEW" }
                        },
                        {
                            "id": "sitemap",
                            "name": "site map",
                            "icon": "yi-bars",
                            "action": { "type": "event", "event": "EV_OPEN_SITEMAP" }
                        },
                        {
                            "id": "about",
                            "name": "about",
                            "icon": "yi-question",
                            "action": { "type": "event", "event": "EV_OPEN_ABOUT" }
                        },
                        { "type": "divider" },
                        {
                            "id": "logout",
                            "name": "logout",
                            "icon": "yi-sign-out-alt",
                            "action": { "type": "event", "event": "EV_LOGOUT" }
                        }
                    ]
                }
            }
        ]
    },

    "menu": {
        "primary": {
            "render": {
                "left":   { "layout": "vertical", "icon_pos": "left", "show_label": true },
                "bottom": { "layout": "icon-bar", "icon_pos": "top",  "show_label": true }
            },
            "items": [
                {
                    "_comment": "No target and no submenu on purpose: /connections is declared in shell.routes, and build_item_index fills a menu item that has a route but no target from there. So there is ONE place that says which gclass the backends page is.",
                    "id": "connections",
                    "name": "connections",
                    "icon": "yi-cloudversify",
                    "tooltip": "Manage the backends this app browses",
                    "route": "/connections"
                },
                {
                    "id": "topics",
                    "name": "topics",
                    "icon": "yi-table",
                    "tooltip": "Browse a treedb's topics as tables",
                    "route": "/topics",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "_default_comment": "The home route /topics/db (not the picker) so C_TREEDB_APP.ac_route_changed can redirect a primary-nav entry to the workspace's last-active tab; the picker stays reachable as its own tab.",
                        "default": "/topics/db",
                        "items": [
                            {
                                "id": "picker",
                                "name": "select",
                                "icon": "yi-square-check",
                                "route": "/topics/select",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_TREEDB_PICKER",
                                    "kw": { "workspace": "topics", "title": "select" },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "graphs",
                    "name": "graphs",
                    "icon": "yi-hexagon-nodes",
                    "tooltip": "Browse a treedb as a node graph",
                    "route": "/graphs",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "_default_comment": "Home route /graphs/db (see topics submenu default comment).",
                        "default": "/graphs/db",
                        "items": [
                            {
                                "id": "picker",
                                "name": "select",
                                "icon": "yi-square-check",
                                "route": "/graphs/select",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_TREEDB_PICKER",
                                    "kw": { "workspace": "graphs", "title": "select" },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    }
}

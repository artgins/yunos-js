{
  "name": "gui-agent",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "description": "Yuneta Agent Console — web SPA (gobj-ui v2 declarative shell) to operate yuneta agents: control-plane CLI, treedb, stats. Connection and auth URLs are configured by the user and stored locally in the browser (no private data committed).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate-locales": "node node_modules/@yuneta/gobj-ui/scripts/validate-locales.mjs",
    "qa": "node scripts/qa.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "check-markup": "node node_modules/@yuneta/gobj-ui/scripts/check-markup-strings.mjs src",
    "prebuild": "npm run validate-locales && npm run check-markup",
    "overflow": "node scripts/overflow.mjs"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "@yuneta/gobj-js": "^7.27.0",
    "@yuneta/gobj-ui": "^7.27.34",
    "bulma": "^1.0.4",
    "i18next": "^26.5.6",
    "tabulator-tables": "^6.7.1",
    "tom-select": "^2.6.2",
    "vanilla-jsoneditor": "^3.13.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

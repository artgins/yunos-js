{
    "_comment": "Agent Console shell config — mobile-app style: an always-on top toolbar with a left brand + right-aligned actions (language, theme, user avatar); a global connection dot on the toolbar reflects the CONTROL-CENTER LINK (the single session transport: green up / red down), which is a different layer from per-node reachability — each node tab keeps its own coloured glyph. Primary nav (Commands / Statistics / Terminal / Schemas) is the left rail on desktop and the bottom icon-bar on mobile; submenus render as top tabs. The four primaries are the WORK of the console and nothing else shares that level: the preferences page hangs off the toolbar avatar as /preferences, which is where a user looks for their own settings and where the yunovatios SPAs already put it. Schemas edits a yuno's treedb_system_schema through the routing adapter; BROWSING data of any other treedb stays in the separate gui_treedb SPA.",

    "shell": {
        "breakpoints": "bulma",

        "zones": {
            "top":     { "host": "toolbar",        "show_on": "*" },
            "left":    { "host": "menu.primary",   "show_on": ">=desktop" },
            "bottom":  { "host": "menu.primary",   "show_on": "<desktop"  },
            "top-sub": { "host": "menu.secondary", "show_on": "*" },
            "center":  { "host": "stage.main" }
        },

        "stages": {
            "main": { "zone": "center", "default_route": "/commands/node" }
        },

        "_routes_comment": "Resolution-ancestor + empty-state routes for the per-node workspaces (a node tab /<ws>/node/<id> resolves here on F5 before the controller rebuilds it). About opens as an adaptive dialog from the account menu (EV_OPEN_ABOUT), not a route. /preferences is a first-level route with NO menu entry: it is reached from the avatar menu, and it stays a route — not a dialog — so it is linkable, survives an F5 and appears in the site map.",
        "routes": {
            "/preferences": {
                "stage": "main",
                "gclass": "C_ACCOUNT_VIEW",
                "kw": { "view": "preference" },
                "lifecycle": "lazy_destroy"
            },
            "/commands/node": {
                "stage": "main",
                "gclass": "C_AGENT_CONSOLE",
                "kw": { "title": "commands", "node": "" },
                "lifecycle": "keep_alive"
            },
            "/statistics/node": {
                "stage": "main",
                "gclass": "C_AGENT_STATS",
                "kw": { "title": "statistics", "node": "" },
                "lifecycle": "keep_alive"
            },
            "/terminal/node": {
                "stage": "main",
                "gclass": "C_AGENT_TTY",
                "kw": { "title": "terminal", "node": "" },
                "lifecycle": "keep_alive"
            },
            "/schemas/node": {
                "stage": "main",
                "gclass": "C_AGENT_TREEDB",
                "kw": { "title": "schemas", "node": "", "yuno_id": "" },
                "lifecycle": "keep_alive"
            }
        }
    },

    "toolbar": {
        "zone": "top",
        "aria_label": "Agent Console toolbar",
        "items": [
            {
                "id": "brand",
                "type": "brand",
                "logo": "/agent-mark.svg",
                "wordmark": "Agent Console",
                "alt": "Agent Console",
                "aria_label": "Agent Console home",
                "action": { "type": "navigate", "route": "/commands/nodes" }
            },
            {
                "id": "lang",
                "icon": "yi-language",
                "name": "ES/EN",
                "align": "end",
                "aria_label": "Toggle language",
                "action": { "type": "event", "event": "EV_TOGGLE_LANGUAGE" }
            },
            {
                "id": "theme",
                "icon": "yi-moon",
                "name": "",
                "align": "end",
                "aria_label": "Toggle dark theme",
                "action": { "type": "event", "event": "EV_TOGGLE_THEME" }
            },
            {
                "id": "conn",
                "type": "connection",
                "align": "end",
                "aria_label": "backend connection",
                "tooltip": "backend connection"
            },
            {
                "id": "user",
                "type": "avatar",
                "align": "end",
                "aria_label": "Account menu",
                "action": {
                    "type": "dropdown",
                    "_items_comment": "Account menu: Preferences first — it is the user's own settings and no longer a primary rail item — then the developer tools, the informative entries and Sign out.",
                    "items": [
                        {
                            "id": "preferences",
                            "name": "preferences",
                            "icon": "yi-gear",
                            "action": { "type": "navigate", "route": "/preferences" }
                        },
                        { "type": "divider" },
                        {
                            "id": "developer",
                            "name": "developer",
                            "icon": "yi-square-js",
                            "action": { "type": "event", "event": "EV_OPEN_DEVTOOLS" }
                        },
                        {
                            "id": "frontend",
                            "name": "frontend view",
                            "icon": "yi-hexagon-nodes",
                            "action": { "type": "event", "event": "EV_OPEN_FRONTEND_VIEW" }
                        },
                        {
                            "id": "sitemap",
                            "name": "site map",
                            "icon": "yi-bars",
                            "action": { "type": "event", "event": "EV_OPEN_SITEMAP" }
                        },
                        {
                            "id": "about",
                            "name": "about",
                            "icon": "yi-question",
                            "action": { "type": "event", "event": "EV_OPEN_ABOUT" }
                        },
                        { "type": "divider" },
                        {
                            "id": "logout",
                            "name": "logout",
                            "icon": "yi-sign-out-alt",
                            "action": { "type": "event", "event": "EV_LOGOUT" }
                        }
                    ]
                }
            }
        ]
    },

    "menu": {
        "primary": {
            "render": {
                "left":   { "layout": "vertical", "icon_pos": "left", "show_label": true },
                "bottom": { "layout": "icon-bar", "icon_pos": "top",  "show_label": true }
            },
            "_items_comment": "Four primary options, all of them WORK — preferences left this level for the avatar menu (/preferences). Each workspace declares ONLY its fixed node-picker tab here; the C_APP workspaces controller replaces the submenu at runtime, keeping this picker as tab 0 and appending one closable tab per selected node (per selected YUNO in Statistics and Schemas, whose picker is the C_STATS_NODES tree). Commands/Statistics/Schemas list only agents >= 7.7.0 (min_version); Terminal (PTY backdoor) lists every version.",
            "items": [
                {
                    "id": "commands",
                    "name": "commands",
                    "icon": "yi-terminal",
                    "tooltip": "Run control-plane commands on a node's yunos (agent >= 7.7.0)",
                    "route": "/commands",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "default": "/commands/node",
                        "items": [
                            {
                                "id": "picker",
                                "name": "nodes",
                                "icon": "yi-cloudversify",
                                "route": "/commands/nodes",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_NODES",
                                    "kw": { "title": "nodes", "workspace": "commands", "min_version": "7.7.0" },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "statistics",
                    "name": "statistics",
                    "icon": "yi-eye",
                    "tooltip": "Live stats from a node's yunos (agent >= 7.7.0)",
                    "route": "/statistics",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "default": "/statistics/node",
                        "items": [
                            {
                                "id": "picker",
                                "name": "nodes",
                                "icon": "yi-cloudversify",
                                "route": "/statistics/nodes",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_STATS_NODES",
                                    "kw": { "title": "nodes", "workspace": "statistics", "min_version": "7.7.0" },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "terminal",
                    "name": "terminal",
                    "icon": "yi-lock",
                    "tooltip": "Interactive SSH-style console to a node (PTY backdoor, any version)",
                    "route": "/terminal",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "default": "/terminal/node",
                        "items": [
                            {
                                "id": "picker",
                                "name": "nodes",
                                "icon": "yi-cloudversify",
                                "route": "/terminal/nodes",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_NODES",
                                    "kw": { "title": "nodes", "workspace": "terminal", "min_version": "" },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "schemas",
                    "name": "schemas",
                    "icon": "yi-hexagon-nodes",
                    "tooltip": "Edit the schemas a yuno keeps in its treedb_system_schema (agent >= 7.7.0)",
                    "route": "/schemas",
                    "submenu": {
                        "render": { "top-sub": "tabs" },
                        "default": "/schemas/node",
                        "items": [
                            {
                                "id": "picker",
                                "name": "nodes",
                                "icon": "yi-cloudversify",
                                "route": "/schemas/nodes",
                                "target": {
                                    "stage": "main",
                                    "gclass": "C_STATS_NODES",
                                    "kw": { "title": "nodes", "workspace": "schemas", "min_version": "7.7.0", "with_treedb_check": true },
                                    "lifecycle": "keep_alive"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    }
}
